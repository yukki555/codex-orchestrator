{
  "codex-delegate-guard": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./skills/codex-orchestrator/scripts/hook_delegate_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "codex-context-handoff": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./skills/codex-orchestrator/scripts/hook_context_guard.py",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./skills/codex-orchestrator/scripts/hook_context_guard.py",
        "timeout": 5
      }
    ]
  }
}
