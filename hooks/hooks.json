{
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "codex-delegate-guard-optout",
            "type": "command",
            "command": "python3 \"${extensionPath}/skills/codex-orchestrator/scripts/hook_delegate_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "write_file|replace|write_to_file|edit_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "name": "codex-delegate-guard",
            "type": "command",
            "command": "python3 \"${extensionPath}/skills/codex-orchestrator/scripts/hook_delegate_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
