{
  "version": "3.9.0",
  "valid_modes": ["consult", "implement", "review", "resume", "research", "critique", "analyze"],
  "valid_efforts": ["low", "medium", "high", "xhigh", "max", "ultra", "inherit"],
  "valid_speeds": ["default", "fast", "ultrafast", "inherit"],
  "valid_verbosities": ["low", "medium", "high", "inherit"],
  "valid_stdout_modes": ["auto", "compact", "facts", "full"],
  "fast_preset": {"model": "gpt-6.2-sol", "effort": "low"},
  "defaults": {
    "effort": "medium",
    "model_by_mode": {
      "implement": "gpt-6.2-sol",
      "consult": "gpt-6.2-sol",
      "review": "gpt-6.2-astra",
      "resume": "gpt-6.2-astra",
      "research": "gpt-6.2-astra",
      "critique": "gpt-6.2-astra",
      "analyze": "gpt-6.2-astra"
    },
    "verbosity_by_mode": {
      "implement": "low",
      "consult": "medium",
      "review": "medium",
      "resume": "medium",
      "research": "medium",
      "critique": "medium",
      "analyze": "medium"
    },
    "stdout_mode_by_mode": {"implement": "facts", "default": "auto"},
    "max_cmds_by_mode": {
      "implement": 12,
      "research": 10,
      "analyze": 10,
      "consult": 8,
      "critique": 8,
      "resume": 8,
      "review_exec": 8,
      "review_native": 0
    },
    "schema_by_mode": {
      "review": "review-output-schema.json",
      "research": "research-output-schema.json",
      "critique": "critique-output-schema.json",
      "analyze": "analysis-output-schema.json",
      "default": "codex-output-schema.json"
    }
  },
  "models": {
    "gpt-6.2-sol": {
      "supports_ultrafast": true,
      "supports_verbosity": true,
      "low_medium_speed": "ultrafast",
      "high_speed": "default"
    },
    "gpt-6.2-astra": {
      "supports_ultrafast": false,
      "downgrade_ultrafast_to": "fast",
      "supports_verbosity": true,
      "low_medium_speed": "fast",
      "high_speed": "default"
    }
  },
  "fallback_model_capabilities": {
    "supports_ultrafast": true,
    "supports_verbosity": true,
    "low_medium_speed": "fast",
    "high_speed": "default"
  },
  "context_handoff": {
    "default_mode": "propose",
    "noise_nudge": {
      "enabled": true,
      "remote_cmd_threshold": 4,
      "remote_streak_threshold": 3,
      "read_file_threshold": 6,
      "read_file_rearm_delta": 6,
      "read_file_min_tokens": 45000,
      "read_file_min_ratio": 0.12,
      "read_spike_tokens": 25000
    },
    "soft_ratio": 0.45,
    "soft_cap_tokens": 200000,
    "hard_ratio": 0.65,
    "hard_cap_tokens": 300000,
    "emergency_ratio": 0.80,
    "checkpoint_fatigue_count": 2,
    "max_hops": 5,
    "default_context_limit": 160000,
    "context_limit_rules": [
      {"pattern": "^gemini[-_ ]4[-_ ](?:neon|hydrogen|carbon|argon)|^gemini[-_ ]pro[-_ ]orchestrator|^gemini[-_ ]flash[-_ ]worker|^orchestrator", "limit": 512000},
      {"pattern": "claude[-_ ](?:opus|sonnet)[-_ ]5[._-]5|^gemini[-_ ]3[._-]8[-_ ]flash", "limit": 256000},
      {"pattern": "claude[-_ ](?:opus|sonnet)[-_ ]4[._-]6", "limit": 160000},
      {"pattern": "^gemini[-_ ]3[._-]1[-_ ]pro|^gemini[-_ ]pro", "limit": 128000},
      {"pattern": "gpt[-_ ]oss", "limit": 80000}
    ],
    "model_tier_fallbacks": [
      {"pattern": "neon|carbon|argon|opus|orchestrator|pro", "tier": "pro"},
      {"pattern": "lite", "tier": "flash_lite"},
      {"pattern": ".*", "tier": "flash"}
    ]
  }
}
