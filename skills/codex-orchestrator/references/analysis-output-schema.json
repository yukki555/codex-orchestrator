{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodexOrchestratorAnalysisEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "key_metrics",
    "consistency_checks",
    "anomalies_and_root_causes",
    "verification",
    "next_experiments"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "consistent",
        "discrepancy_found",
        "inconclusive",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "key_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "value",
          "source_location",
          "notes"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "source_location": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "consistency_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "status",
          "expected",
          "observed",
          "evidence_location"
        ],
        "properties": {
          "dimension": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "match",
              "mismatch",
              "unverified"
            ]
          },
          "expected": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "evidence_location": {
            "type": "string"
          }
        }
      }
    },
    "anomalies_and_root_causes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding",
          "severity",
          "evidence_location",
          "explanation"
        ],
        "properties": {
          "finding": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "evidence_location": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_code",
          "key_output"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "key_output": {
            "type": "string"
          }
        }
      }
    },
    "next_experiments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
